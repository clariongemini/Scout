 {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scoutcard-v2/schemas/verified_player/4.0.0/breaking-field-type-changed.json",
  "title": "Verified Player Schema - Breaking Field Type Changed",
  "description": "Schema with field type changed (breaking change)",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "playerName",
    "canonicalId",
    "verifiedAt",
    "metrics",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "4.0.0"
    },
    "recordType": {
      "type": "string",
      "const": "verified_player"
    },
    "recordId": {
      "type": "number",
      "description": "Changed from string to number (breaking)"
    },
    "playerName": {
      "type": "string"
    },
    "canonicalId": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
