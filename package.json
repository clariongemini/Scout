{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:observation-layer": "vitest run server/fsrs-v4/observation-layer/__tests__/",
    "test:arch011": "vitest run server/fsrs-v4/architecture/__tests__/",
    "architecture:test": "vitest run architecture/tests/",
    "architecture:mutation-test": "tsx architecture/tests/mutation-tests.ts",
    "architecture:gate": "tsx architecture/gates/run-gates.ts",
    "architecture:docs": "tsx architecture/generators/documentation-generator.ts",
    "contract:test": "tsx architecture/tests/contract-tests.ts",
    "schema:test": "tsx architecture/tests/schema-tests.ts",
    "fsrs:validate-player": "tsx scripts/fsrs-validate-player.ts",
    "fsrs:validate-mert": "tsx server/fsrs-v4/validation/run-mert-validation.ts",
    "fsrs:validate-mert-v2": "tsx server/fsrs-v4/validation/run-mert-validation-v2.ts",
    "fsrs:generate-comparison": "tsx server/fsrs-v4/validation/generate-before-after-report.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.1",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fotmob": "^2.4.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.0.0"
  }
}
