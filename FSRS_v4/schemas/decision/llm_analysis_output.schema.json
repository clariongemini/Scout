{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/llm_analysis_output.schema.json",
  "title": "FSRS v4 llm_analysis_output",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "llm_analysis_output"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "canonicalPlayerId": {},
    "claims": {
      "type": "array"
    },
    "summary": {},
    "strengths": {
      "type": "array"
    },
    "developmentAreas": {
      "type": "array"
    },
    "riskNarrative": {},
    "decisionNarrative": {},
    "unsupportedClaimIds": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
