{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSRS Final Scout Report v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "reportId",
    "canonicalPlayerId",
    "sourceRefs",
    "renderPolicy",
    "publicationGate"
  ],
  "properties": {
    "recordType": {
      "const": "final_scout_report"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "renderPolicy": {
      "type": "object",
      "required": [
        "singleSourceOfTruth"
      ],
      "properties": {
        "singleSourceOfTruth": {
          "const": true
        }
      }
    }
  },
  "additionalProperties": true
}