{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/source_lineage.schema.json",
  "title": "FSRS v4 source_lineage",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "source_lineage"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sourceId": {},
    "upstreamProviderId": {},
    "independenceGroup": {},
    "evidence": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
