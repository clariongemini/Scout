{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/metric_observation.schema.json",
  "title": "FSRS v4 metric_observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "metric_observation"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "canonicalPlayerId": {},
    "metricId": {},
    "metricDefinitionVersion": {},
    "value": {},
    "unit": {}
  },
  "additionalProperties": false
}
