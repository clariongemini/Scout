{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/squad_fit.schema.json",
  "title": "FSRS v4 squad_fit",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "depthChartSnapshot": {
      "type": "object"
    },
    "availabilityImpact": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "squad_fit"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "canonicalPlayerId": {},
    "targetClubId": {},
    "roleNeedScore": {},
    "marginalImpactScore": {},
    "partnerSynergies": {
      "type": "array"
    },
    "roleConflicts": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
