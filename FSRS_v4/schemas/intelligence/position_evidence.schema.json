{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/position_evidence.schema.json",
  "title": "FSRS v4 position_evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "classification": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "position_evidence"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "canonicalPlayerId": {},
    "officialStartingPositions": {
      "type": "array"
    },
    "lineupRoleMinutes": {
      "type": "array"
    },
    "averagePositions": {
      "type": "array"
    },
    "eventZoneProfiles": {
      "type": "array"
    },
    "heatmapRefs": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
