{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsrs.local/schemas/v4/role_classification.schema.json",
  "title": "FSRS v4 role_classification",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "recordId",
    "createdAt",
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "object"
    },
    "schemaVersion": {
      "type": "string"
    },
    "recordType": {
      "const": "role_classification"
    },
    "recordId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "canonicalPlayerId": {},
    "positionScope": {},
    "roleCandidates": {
      "type": "array"
    },
    "primaryRole": {},
    "secondaryRoles": {
      "type": "array"
    },
    "archetypes": {
      "type": "array"
    },
    "evidenceMetricIds": {
      "type": "array"
    },
    "contradictingEvidenceMetricIds": {
      "type": "array"
    },
    "sampleMinutes": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
