{
  "schemaVersion": "4.0.0",
  "recordType": "prompt_contract",
  "routeId": "st_v4",
  "positionEngine": "ST",
  "allowedSections": [
    "verifiedFacts",
    "positionRoleContext",
    "benchmarks",
    "fitAndDecision",
    "limitations"
  ],
  "requiredOutput": [
